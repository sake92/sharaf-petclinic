  def scalaVersion = "3.7.1"

  def scalacOptions = super.scalacOptions() ++ Seq(
    "-Yretain-trees",
    "-deprecation",
    "-Wunused:all"
  )

  def mvnDeps = Seq(
    mvn"ba.sake::sharaf-undertow:0.13.0",
    mvn"ba.sake::sharaf-hepek-components:0.13.0",
    mvn"ba.sake::squery:0.7.0",
    mvn"org.flywaydb:flyway-core:8.5.5",
    mvn"com.zaxxer:HikariCP:5.0.1",
    mvn"org.postgresql:postgresql:42.6.0",
    mvn"io.scalaland::chimney::1.0.0",
    mvn"ch.qos.logback:logback-classic:1.4.6"
  )

  object test extends ScalaTests with TestModule.Munit {
    def munitVersion = "1.1.0"
    def mvnDeps = Seq(
      mvn"org.testcontainers:postgresql:1.17.6"
    )
  }
